# Copia este archivo como .env.local y ajusta la IP:
#   cp .env.example .env.local
# Dirección del servidor (la IP de tu computador en la red wifi, puerto 3000).
# OJO: las variables EXPO_PUBLIC_* quedan visibles dentro de la app. Nunca pongas secretos aquí.
EXPO_PUBLIC_API_URL=http://192.168.1.7:3000
