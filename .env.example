# Copia este archivo como .env y completa los valores:
#   cp .env.example .env
# Genera contraseñas seguras con:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gestor_mvp
DB_USER=gestor_app
DB_PASSWORD=cambia_esto

# Solo lo usa docker-compose para inicializar MySQL
MYSQL_ROOT_PASSWORD=cambia_esto_tambien

# --- Acceso a la app ---
# NO escribas la contraseña aquí: créala con  npm run crear-password
# (guarda solo su hash y genera un TOKEN_SECRET nuevo)
ADMIN_PASSWORD_HASH=
TOKEN_SECRET=

# Orígenes web con permiso CORS, separados por coma. La app nativa no lo necesita.
# Ejemplo para la versión web de Expo en desarrollo: http://localhost:8081
CORS_ORIGINS=

# --- IA para revisar comprobantes (opcional) ---
# Proveedores en orden de preferencia; si uno falla (cuota, límite, caída) se usa el siguiente.
# Vacío = IA desactivada. Disponibles: nvidia, gemini, simulado (datos falsos, para desarrollo).
IA_PROVEEDORES=
NVIDIA_API_KEY=
NVIDIA_MODELO=
GEMINI_API_KEY=
GEMINI_MODELO=
# Segundos máximos de espera por proveedor (en milisegundos)
IA_TIEMPO_LIMITE_MS=45000
